# Resend API key (https://resend.com)
RESEND_API_KEY=

# Email that receives verified contact messages
CONTACT_OWNER_EMAIL=benbenching@gmail.com

# Secret used to sign verification tokens (generate a long random string)
CONTACT_JWT_SECRET=

# Optional: verified sender address in Resend (defaults to onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Used for magic links in local dev
SITE_URL=http://localhost:8888
